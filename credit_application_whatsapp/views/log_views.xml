<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_credit_wa_log_search" model="ir.ui.view">
    <field name="name">credit.whatsapp.log.search</field><field name="model">credit.whatsapp.log</field>
    <field name="arch" type="xml"><search>
      <field name="application_id"/><field name="company_id"/><field name="recipient"/>
      <filter string="Errores" name="failed" domain="[('status','=','failed')]"/>
      <filter string="Pendientes" name="pending" domain="[('status','=','pending')]"/>
      <group expand="0" string="Agrupar por"><filter name="by_company" string="Empresa" context="{'group_by':'company_id'}"/>
        <filter name="by_event" string="Etapa" context="{'group_by':'event'}"/>
        <filter name="by_status" string="Resultado" context="{'group_by':'status'}"/></group>
    </search></field>
  </record>
  <record id="view_credit_wa_log_list" model="ir.ui.view">
    <field name="name">credit.whatsapp.log.list</field><field name="model">credit.whatsapp.log</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0"
          decoration-success="status == 'sent'" decoration-danger="status == 'failed'">
      <field name="create_date"/><field name="company_id"/><field name="application_id"/>
      <field name="event"/><field name="recipient"/><field name="origin"/>
      <field name="status" widget="badge"/><field name="attempts"/>
      <field name="error_message" optional="hide"/>
    </list></field>
  </record>
  <record id="view_credit_wa_log_form" model="ir.ui.view">
    <field name="name">credit.whatsapp.log.form</field><field name="model">credit.whatsapp.log</field>
    <field name="arch" type="xml"><form string="Mensaje WhatsApp" create="0" edit="0" delete="0">
      <header><button name="action_retry" type="object" string="Reintentar" class="btn-primary"
               groups="custom_web_credito_conedera.group_credit_administrator" invisible="status == 'sent' or status == 'skipped'"/>
        <field name="status" widget="statusbar"/></header>
      <sheet><group><group><field name="application_id"/><field name="company_id"/><field name="event"/>
          <field name="template_id"/><field name="campaign_id"/><field name="origin"/>
          <field name="recipient"/></group>
          <group><field name="attempts"/><field name="sent_at"/><field name="next_retry"/>
          <field name="http_status"/><field name="retryable"/><field name="unique_key"/></group></group>
          <group string="Mensaje"><field name="body" nolabel="1"/></group>
          <group string="Respuesta"><field name="error_message"/><field name="response_text"/>
          <field name="payload_json"/></group></sheet>
    </form></field>
  </record>
  <record id="action_credit_wa_log" model="ir.actions.act_window">
    <field name="name">Historial WhatsApp</field><field name="res_model">credit.whatsapp.log</field>
    <field name="view_mode">list,form</field><field name="search_view_id" ref="view_credit_wa_log_search"/>
  </record>
  <menuitem id="menu_credit_wa_logs" name="Historial de mensajes" parent="menu_credit_wa_root"
            action="action_credit_wa_log" sequence="30" groups="custom_web_credito_conedera.group_credit_manager"/>
</odoo>
