<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cron_credit_whatsapp_queue" model="ir.cron">
        <field name="name">Solicitud de crédito: enviar cola WhatsApp</field>
        <field name="model_id" ref="model_credit_whatsapp_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="cron_credit_whatsapp_campaigns" model="ir.cron">
        <field name="name">Solicitud de crédito: cerrar campañas WhatsApp</field>
        <field name="model_id" ref="model_credit_whatsapp_campaign"/>
        <field name="state">code</field>
        <field name="code">model._cron_finish_campaigns()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
