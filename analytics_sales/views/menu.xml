<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_analytics_sales_dashboard" model="ir.actions.client">
        <field name="name">Analytics Sales | Dashboard comercial</field>
        <field name="tag">analytics_sales.Dashboard</field>
    </record>
    <menuitem id="menu_analytics_sales_root" name="Analytics Sales" sequence="25" web_icon="analytics_sales,static/description/icon.png"
              groups="analytics_sales.group_analytics_sales_tienda,analytics_sales.group_analytics_sales_supervisor,analytics_sales.group_analytics_sales_admin"/>
    <menuitem id="menu_analytics_sales_dashboard" name="Panel comercial" parent="menu_analytics_sales_root" action="action_analytics_sales_dashboard" sequence="1"/>
    <menuitem id="menu_analytics_sales_admin" name="Administración" parent="menu_analytics_sales_root" sequence="40"
              groups="analytics_sales.group_analytics_sales_admin"/>
    <menuitem id="menu_analytics_sales_local" name="Locales" parent="menu_analytics_sales_admin" action="action_analytics_sales_local" sequence="5"/>
    <menuitem id="menu_analytics_sales_establishment" name="Establecimiento"
              parent="menu_analytics_sales_admin" action="action_analytics_sales_establishment" sequence="7"/>
    <menuitem id="menu_analytics_sales_warehouse" name="Bodega" parent="menu_analytics_sales_admin"
              action="action_analytics_sales_warehouse" sequence="8"/>
    <menuitem id="menu_analytics_sales_goals" name="Metas" parent="menu_analytics_sales_admin"
              action="action_analytics_sales_goal" sequence="9"/>
    <menuitem id="menu_analytics_sales_user_access" name="Usuarios y permisos" parent="menu_analytics_sales_admin" action="action_analytics_sales_user_access" sequence="10"/>
    <menuitem id="menu_analytics_sales_settings" name="Configuración API" parent="menu_analytics_sales_admin" action="action_analytics_sales_settings_saved" sequence="20"/>
    <menuitem id="menu_analytics_sales_import_excel" name="Importar Excel" parent="menu_analytics_sales_admin" action="action_analytics_sales_excel_import" sequence="25"/>
    <menuitem id="menu_analytics_sales_sync_log" name="Historial de sincronización" parent="menu_analytics_sales_admin" action="action_analytics_sales_sync_log" sequence="30"/>
    <!-- Force replacement on upgrade; menuitem groups attributes alone can leave
         old base.group_system groups in previously installed databases. -->
    <record id="menu_analytics_sales_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('analytics_sales.group_analytics_sales_tienda'), ref('analytics_sales.group_analytics_sales_supervisor'), ref('analytics_sales.group_analytics_sales_admin')])]"/>
    </record>
    <record id="menu_analytics_sales_local" model="ir.ui.menu">
        <field name="name">Locales</field>
    </record>
    <record id="menu_analytics_sales_establishment" model="ir.ui.menu">
        <field name="name">Establecimiento</field>
    </record>
    <record id="menu_analytics_sales_admin" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('analytics_sales.group_analytics_sales_admin')])]"/>
    </record>
</odoo>
