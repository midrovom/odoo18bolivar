<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_analytics_sales_category_list" model="ir.ui.view">
        <field name="name">analytics.sales.category.list</field>
        <field name="model">analytics.sales.category</field>
        <field name="arch" type="xml">
            <list string="Atributos" create="0" edit="0" delete="0" import="0" duplicate="0">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_analytics_sales_category_form" model="ir.ui.view">
        <field name="name">analytics.sales.category.form</field>
        <field name="model">analytics.sales.category</field>
        <field name="arch" type="xml">
            <form string="Atributo de ventas" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                    <p class="text-muted">Este atributo se obtiene del campo Línea (Linea) de los movimientos de ventas. Para incluirlo en el botón personalizado, vaya a Administración → Ámbito de análisis.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_analytics_sales_category_master" model="ir.actions.server">
        <field name="name">Atributos</field>
        <field name="model_id" ref="model_analytics_sales_category"/>
        <!-- Odoo 18 checks model write access for ungrouped server actions.
             This action only opens a read-only catalog; authorize by group. -->
        <field name="groups_id" eval="[(6, 0, [ref('analytics_sales.group_analytics_sales_admin')])]"/>
        <field name="state">code</field>
        <field name="code">action = env['analytics.sales.category'].action_open_master()</field>
    </record>
</odoo>
