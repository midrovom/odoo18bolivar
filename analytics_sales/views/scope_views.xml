<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_analytics_sales_scope_form" model="ir.ui.view">
        <field name="name">analytics.sales.settings.scope.form</field>
        <field name="model">analytics.sales.settings</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Ámbito de análisis" create="0" delete="0" duplicate="0">
                <sheet>
                    <h2>Ámbito de análisis</h2>
                    <p>Configure el botón personalizado del panel comercial seleccionando los atributos del maestro de ventas de esta compañía.</p>
                    <group>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group string="Categorías del botón personalizado">
                        <field name="dashboard_scope_name" placeholder="Ej. Telefonía"/>
                        <field name="dashboard_category_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="dashboard_scope_default" invisible="not dashboard_category_ids"/>
                    </group>
                    <p class="text-muted">Guarde los cambios con el botón Guardar de Odoo. Los atributos se incorporan automáticamente al maestro al sincronizar las ventas. El botón personalizado solo incluye los seleccionados; Todas las líneas conserva todas las categorías disponibles. Sin atributos seleccionados, se oculta el botón personalizado.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_analytics_sales_scope_saved" model="ir.actions.server">
        <field name="name">Ámbito de análisis</field>
        <field name="model_id" ref="model_analytics_sales_settings"/>
        <field name="state">code</field>
        <field name="code">action = env['analytics.sales.settings'].action_open_scope()</field>
    </record>
</odoo>
