<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="analytics_sales.Dashboard" owl="1">
<div t-att-class="'as-sales ' + roleClass" role="main">
  <div class="as-app">
    <header class="as-head">
      <div class="as-brand">
        <t t-if="presentation.logo_url">
          <img class="as-logo-image" t-att-src="presentation.logo_url" t-att-alt="brandTitle"/>
        </t>
        <t t-else="">
          <div class="as-logo" t-att-class="presentation.logo.length > 3 ? 'as-logo-long' : ''" t-esc="presentation.logo"/>
        </t>
        <div><strong t-esc="brandTitle"/><small t-esc="presentation.subtitle"/></div>
      </div>
      <button t-if="state.nativeMenuAvailable" type="button" class="as-button as-mobile-menu" t-on-click="onToggleNativeMenu" t-att-aria-expanded="state.nativeMenuOpen ? 'true' : 'false'" t-att-aria-label="state.nativeMenuOpen ? 'Ocultar menú de Odoo' : 'Mostrar menú de Odoo'">
        <i t-att-class="state.nativeMenuOpen ? 'fa fa-times' : 'fa fa-bars'" aria-hidden="true"/><span t-esc="state.nativeMenuOpen ? 'Cerrar menú' : 'Menú Odoo'"/>
      </button>
      <div class="as-head-actions">
        <span class="as-chip"><span class="as-status-dot"/><t t-esc="dataSourceLabel"/></span>
        <button class="as-button" t-on-click="onGuide" type="button">ⓘ&#160; Cómo se calcula</button>
        <button class="as-button as-primary" t-on-click="onExport" t-att-disabled="!hasData" type="button">↓&#160; Exportar CSV</button>
      </div>
    </header>
    <div t-if="state.loading" class="as-empty">Cargando información de ventas…</div>
    <div t-if="state.error" class="as-error"><strong>No fue posible actualizar los indicadores.</strong><span t-esc="state.error"/></div>
    <t t-if="hasData">
      <section class="as-hero">
        <div><div class="as-eyebrow">Business Intelligence · Dashboard gerencial · Datos reales</div><h1 t-esc="title"/><p t-esc="subtitle"/></div>
        <div class="as-rolebox"><span class="as-role-note">PERFIL ACTUAL</span><span class="as-role"><t t-esc="profileLabel"/> · <t t-esc="state.data.company"/></span>
          <button t-if="isAdmin" class="as-button" t-on-click="onSync" t-att-disabled="state.syncing" type="button"><t t-esc="state.syncing ? 'Sincronizando…' : 'Actualizar información'"/></button>
        </div>
      </section>
      <div class="as-role-banner">
        <span t-if="isAdmin">◈ <strong>Administración:</strong> todos los locales de la compañía, costos y rentabilidad.</span>
        <span t-elif="isStore">▣ <strong>Tienda:</strong> resultados únicamente del local <strong t-esc="selectedLocalName"/>. Sin costos ni comparativos de otras tiendas.</span>
        <span t-else="">◎ <strong>Supervisión:</strong> compara únicamente locales nlocal autorizados, vendedores y facturas. Sin acceso a costos ni márgenes.</span>
        <span t-if="state.refreshing" class="as-updating">Actualizando…</span>
        <div t-if="apiFreshnessLabel" class="as-freshness">
          <div t-if="apiFreshnessLabel" t-esc="apiFreshnessLabel"/>
        </div>
      </div>
      <section class="as-scope">
        <div class="as-scope-copy"><strong>Ámbito de análisis</strong><span t-esc="scopeDescription"/></div>
        <div class="as-segments">
          <button t-if="hasCustomScope" type="button" t-att-class="state.filters.scope === 'configured' ? 'selected' : ''" data-scope="configured" t-on-click="onScope" t-esc="presentation.scope_name"/>
          <button type="button" t-att-class="state.filters.scope === 'all' ? 'selected' : ''" data-scope="all" t-on-click="onScope">Todas las líneas</button>
        </div>
      </section>
      <div class="as-data-warning"><strong>Nota de calidad de datos:</strong> Las devoluciones DE pueden referirse a facturas emitidas fuera del período consultado. La relación DE/FA del filtro no es necesariamente una tasa de devolución por cohorte.</div>
        <div t-if="state.openDropdown" class="as-dropdown-dismiss" t-on-click="onDropdownDismiss" aria-hidden="true"/>
      <section class="as-filters" aria-label="Filtros comerciales">
        <t t-foreach="filterFields" t-as="field" t-key="field.key">
          <div class="as-filter-control">
            <span class="as-control-title" t-esc="field.title"/>
            <div class="as-filter-dropdown" t-on-keydown="onDropdownKeydown">
              <button type="button" class="as-dropdown-trigger" t-att-disabled="field.disabled"
                  t-att-data-field="field.key" t-on-click="onDropdownToggle"
                  t-att-aria-label="field.title + ': ' + filterValue(field.key)"
                  aria-haspopup="listbox" t-att-aria-expanded="state.openDropdown === field.key ? 'true' : 'false'"
                  t-att-class="state.openDropdown === field.key ? 'as-dropdown-trigger is-open' : 'as-dropdown-trigger'">
                <span t-esc="filterValue(field.key)"/><span class="as-chevron" aria-hidden="true">⌄</span>
              </button>
              <div t-if="state.openDropdown === field.key" class="as-dropdown-menu" role="listbox" t-att-aria-label="field.title">
                <button t-if="field.allowAll" type="button" role="option" class="as-dropdown-option" data-value="all"
                    t-att-data-field="field.key" t-on-click="onDropdownChoose"
                    t-att-aria-selected="state.filters[field.key] === 'all' ? 'true' : 'false'"
                    t-att-class="state.filters[field.key] === 'all' ? 'as-dropdown-option is-selected' : 'as-dropdown-option'"
                    t-esc="field.all"/>
                <t t-foreach="field.choices" t-as="choice" t-key="choice.value">
                  <button type="button" role="option" t-att-data-value="choice.value" t-att-data-field="field.key"
                    t-on-click="onDropdownChoose"
                    t-att-class="(state.filters[field.key] || 'all').toString() === choice.value ? 'as-dropdown-option is-selected' : 'as-dropdown-option'"
                    t-att-aria-selected="(state.filters[field.key] || 'all').toString() === choice.value ? 'true' : 'false'"
                    t-esc="choice.label"/>
                </t>
                <div t-if="!field.choices.length" class="as-dropdown-empty">No hay opciones en este filtro.</div>
              </div>
            </div>
          </div>
        </t>
        <label class="as-period-control"><span>Período</span><select class="as-period-select" aria-label="Período de ventas" t-att-value="state.period" t-on-change="onPeriod">
          <option value="month">Mes actual</option>
          <option value="previous_month">Mes anterior</option>
          <option value="30">30 días</option>
          <option value="90">90 días</option>
          <option value="year">Año</option>
          <option t-if="state.period === 'custom'" value="custom">Personalizado</option>
        </select></label>
        <label><span>Rango de fechas</span><div class="as-dates"><input type="date" data-field="date_from" t-att-value="state.period === 'custom' ? (state.filters.date_from || state.data.date_from) : state.data.date_from" t-on-change="onFilterChange"/><input type="date" data-field="date_to" t-att-value="state.period === 'custom' ? (state.filters.date_to || state.data.date_to) : state.data.date_to" t-on-change="onFilterChange"/></div></label>
      </section>
      <div class="as-summary"><span><strong t-esc="num(state.data.rows_filtered)"/> líneas · <strong t-esc="num(state.data.metrics.invoices)"/> facturas FA únicas · desde <t t-esc="state.data.date_from"/> hasta <t t-esc="state.data.date_to"/></span><span><strong>FA</strong> suma · <strong>DE</strong> resta · <span class="as-data-label" t-esc="dataSourceLabel"/></span></div>
      <section t-if="isAdmin &amp;&amp; state.data.warehouse_dashboard" class="as-panel-fullwidth as-section" aria-label="Bodegas por establecimiento">
        <article class="as-panel as-warehouse-panel">
          <div class="as-panel-head"><div><h2>Valor de bodegas por establecimiento</h2><p>Últimos valores recibidos de la API de bodegas. Se aplica únicamente el filtro de establecimiento; local, período y demás filtros de ventas no modifican el inventario valorizado.</p></div><span class="as-tag">Bodegas · USD</span></div>
          <div class="as-warehouse-summary"><span><strong t-esc="num(state.data.warehouse_dashboard.count)"/> bodegas · Stock total: <strong t-esc="num(state.data.warehouse_dashboard.stock)"/></span><span class="as-warehouse-total">Valor total uds: <strong t-esc="money(state.data.warehouse_dashboard.value)"/></span></div>
          <p class="as-muted-note" t-if="warehouseFreshnessLabel" t-esc="warehouseFreshnessLabel"/>
          <div t-if="!state.data.warehouse_dashboard.groups.length" class="as-empty">No hay bodegas para esta selección. Actualice la API de bodegas y relacione las bodegas desde Administración → Establecimiento.</div>
          <div t-else="" class="as-table-wrap as-warehouse-table as-warehouse-compact" tabindex="0" aria-label="Stock y valor total por establecimiento">
            <table>
              <thead><tr><th>Establecimiento</th><th class="as-num">Stock</th><th class="as-num">Valor (uds.)</th></tr></thead>
              <tbody>
                <t t-foreach="state.data.warehouse_dashboard.groups" t-as="group" t-key="group.id">
                  <tr>
                    <td class="as-warehouse-establishment"><strong t-esc="group.name"/></td>
                    <td class="as-num" t-esc="num(group.stock)"/>
                    <td class="as-num as-warehouse-amount" t-esc="money(group.value)"/>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </article>
      </section>
      <section class="as-panel-fullwidth as-section" aria-label="Ventas netas por establecimientos">
<article class="as-panel">
          <div class="as-panel-head"><div>
            <h2 t-esc="state.data.selected_establishment_id &amp;&amp; state.data.selected_local_id ? 'Ventas netas del local seleccionado' : 'Ventas netas por establecimientos'"/>
            <p t-esc="state.data.selected_establishment_id &amp;&amp; state.data.selected_local_id ? 'Venta del local seleccionado como aporte a la meta del establecimiento completo (100% = meta alcanzada).' : state.data.selected_establishment_id ? 'Venta neta de sus locales autorizados frente a su meta del período (100% = meta alcanzada).' : 'Comparativo por establecimiento: cada barra muestra el avance de la venta neta hacia su propia meta (100% = meta alcanzada).'"/>
          </div><span class="as-tag" t-esc="isStore ? 'Solo autorizado' : isAdmin ? 'Gerencia' : 'Supervisión'"/></div>
          <div class="as-local-bars-scroll" tabindex="0" aria-label="Gráfico desplazable de ventas netas por establecimientos">
            <div class="as-local-bars">
              <t t-foreach="establishmentComparison" t-as="r" t-key="r.name">
                <div class="as-local-row">
                  <span class="as-local-name" t-esc="r.name" t-att-title="r.name"/>
                  <div class="as-local-content">
                    <div t-att-class="'as-track as-establishment-goal-track' + (r.goal_target > 0 ? (r.sales >= r.goal_target ? ' as-goal-met' : '') : ' as-goal-unset')" t-att-title="comparisonCompliance(r)"><div t-att-style="'width:' + comparisonGoalWidth(r)"/></div>
                    <small>Venta neta <strong t-esc="money(r.sales)"/> · FA <t t-esc="money(r.fa_sales)"/> · DE <t t-esc="money(r.de_sales)"/> · <t t-esc="num(r.units)"/> uds. netas · <t t-esc="comparisonComplianceLabel"/>: <strong t-esc="comparisonCompliance(r)"/></small>
                  </div>
                  <div class="as-local-net as-local-goal"><small>Meta</small><strong t-esc="comparisonGoalAmount(r)"/></div>
                </div>
              </t>
              <div t-if="!establishmentComparison.length" class="as-empty">Sin datos para los filtros.</div>
            </div>
          </div>
          <div class="as-local-table-hint" t-esc="state.data.selected_establishment_id &amp;&amp; state.data.selected_local_id ? 'Resumen del local seleccionado. La tabla inferior permite desplazamiento lateral.' : 'Desplaza el gráfico para ver los establecimientos. La tabla inferior permite desplazamiento lateral.'"/>
          <div class="as-table-wrap as-local-scroll" tabindex="0" aria-label="Tabla por establecimientos, desplazable en ambos sentidos"><table>
            <thead><tr>
              <th t-esc="state.data.selected_establishment_id &amp;&amp; state.data.selected_local_id ? 'Local' : 'Establecimiento'"/>
              <th class="as-num">Facturas FA</th><th class="as-num">Vendido FA (uds.)</th><th class="as-num">Unidades devueltas DE</th><th class="as-num">Unidades netas</th><th class="as-num">Facturado FA</th><th class="as-num">Devuelto DE</th><th class="as-num">Venta neta</th><th class="as-num" t-esc="comparisonComplianceLabel"/><th class="as-num">Ticket FA</th>
              <th class="as-num">Notas DE</th><th class="as-num">DE/FA</th>
              <th t-if="isAdmin" class="as-num">Utilidad</th><th t-if="isAdmin" class="as-num">Margen</th>
            </tr></thead>
            <tbody><t t-foreach="establishmentComparison" t-as="r" t-key="r.name"><tr>
              <td t-esc="r.name"/><td class="as-num" t-esc="num(r.invoices)"/>
              <td class="as-num" t-esc="num(r.fa_units)"/><td class="as-num" t-esc="num(r.de_units)"/><td class="as-num" t-esc="num(r.units)"/>
              <td class="as-num" t-esc="money(r.fa_sales)"/><td class="as-num" t-esc="money(r.de_sales)"/>
              <td class="as-num" t-esc="money(r.sales)"/><td class="as-num" t-esc="comparisonCompliance(r)"/><td class="as-num" t-esc="money(r.ticket)"/>
              <td class="as-num" t-esc="num(r.credit_notes)"/>
              <td class="as-num" t-esc="pct(r.return_rate)"/>
              <td t-if="isAdmin" class="as-num" t-esc="money(r.profit)"/>
              <td t-if="isAdmin" class="as-num" t-esc="pct(r.margin)"/>
            </tr></t></tbody>
          </table></div>
        </article>
      </section>
      <section class="as-panel-fullwidth as-section" aria-label="Cumplimiento de metas">
        <article class="as-panel">
          <div class="as-panel-head"><div>
            <h2>Cumplimiento de metas por vendedor</h2>
            <p t-esc="goalProgress.available ? goalProgress.note : 'No hay establecimientos con locales autorizados para mostrar.'"/>
          </div><span class="as-tag">Metas</span></div>
          <t t-if="goalProgress.available">
            <div class="as-goal-list-header"><span>Vendedores: <strong t-esc="goalSellers.length"/></span><small>La barra muestra la venta neta respecto a la meta individual. El importe a su derecha es la meta.</small></div>
            <div class="as-local-bars-scroll as-goal-seller-bars-scroll" tabindex="0" t-att-aria-label="'Cumplimiento de vendedores: ' + goalProgress.establishment_name">
              <div class="as-local-bars as-goal-seller-bars">
                <t t-foreach="goalSellers" t-as="r" t-key="r.code ? 'code:' + r.code.toUpperCase() : 'name:' + r.name.toLowerCase()">
                  <div class="as-local-row as-goal-seller-row">
                    <div class="as-goal-seller as-goal-seller-name"><strong t-esc="r.name" t-att-title="r.name"/><small t-if="r.code" t-esc="r.code"/></div>
                    <div class="as-local-content as-goal-seller-content">
                      <div t-att-class="'as-track as-establishment-goal-track' + (r.target &gt; 0 ? (r.actual &gt;= r.target ? ' as-goal-met' : '') : ' as-goal-unset')" role="img" t-att-aria-label="r.target &gt; 0 ? 'Cumplimiento: ' + pct(r.compliance) : 'Sin meta'" t-att-title="r.target &gt; 0 ? pct(r.compliance) : 'Sin meta'"><div t-att-style="'width:' + goalProgressWidth(r.actual, r.target)"/></div>
                      <small>Venta neta <strong t-esc="money(r.actual)"/> · Diferencia: <strong t-esc="r.target &gt; 0 ? money(r.difference) : '—'"/> · Cumplimiento: <strong t-esc="r.target &gt; 0 ? pct(r.compliance) : 'Sin meta'"/></small>
                    </div>
                    <div class="as-local-net as-local-goal as-goal-seller-target"><small>Meta</small><strong t-esc="r.target &gt; 0 ? money(r.target) : 'Sin meta'"/></div>
                  </div>
                </t>
                <div t-if="!goalSellers.length" class="as-empty">No se identificaron vendedores en los locales autorizados para esta consulta.</div>
              </div>
            </div>
          </t>
          <div t-else="" class="as-empty" t-esc="goalProgress.message"/>
        </article>
      </section>
      <section class="as-metrics" aria-label="Indicadores principales">
        <t t-foreach="cards" t-as="k" t-key="k.key"><article t-att-class="'as-card accent-' + k.accent"><div class="as-card-title"><span t-esc="k.label"/><span class="as-card-icon" t-esc="k.key === 'sales' ? '↗' : k.key === 'invoices' ? '▤' : k.key === 'credit_notes' ? '↩' : '◇'"/></div><strong class="as-card-value" t-esc="k.val"/><small t-esc="k.detail"/></article></t>
      </section>
      <div class="as-grid-main as-section">
        <article class="as-panel"><div class="as-panel-head"><div><h2>Evolución de ventas netas</h2><p>Facturación FA y devoluciones DE, según período y filtros.</p></div><span class="as-tag">USD</span></div>
          <div class="as-trend-plot" t-if="trendPlot">
            <svg viewBox="0 0 680 232" preserveAspectRatio="none" role="img" aria-label="Evolución mensual de facturación FA y devoluciones DE">
              <t t-foreach="trendPlot.axis" t-as="axis" t-key="axis_index"><line x1="34" x2="652" t-att-y1="axis.y" t-att-y2="axis.y" stroke="#37415a" stroke-width="0.8" stroke-dasharray="4 6"/><text x="30" t-att-y="axis.y + 4" text-anchor="end" fill="#929eb7" font-size="9" t-esc="num(axis.value)"/></t>
              <path t-att-d="trendPlot.area" fill="#b6a6ff" fill-opacity="0.09"/>
              <path t-att-d="trendPlot.faPath" fill="none" stroke="#b6a6ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <path t-att-d="trendPlot.dePath" fill="none" stroke="#f8a4c3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <t t-foreach="trendPlot.fa" t-as="p" t-key="p_index"><circle t-att-cx="p.x" t-att-cy="p.y" r="3.2" fill="#b6a6ff"><title t-esc="p.label + ' · FA ' + money(p.value)"/></circle></t>
              <t t-foreach="trendPlot.de" t-as="p" t-key="p_index"><circle t-att-cx="p.x" t-att-cy="p.y" r="2.8" fill="#f8a4c3"><title t-esc="p.label + ' · DE ' + money(p.value)"/></circle></t>
              <t t-foreach="trendPlot.labels" t-as="lab" t-key="lab_index"><text t-att-x="lab.x" y="218" text-anchor="middle" fill="#a4afc5" font-size="10" t-esc="lab.name"/></t>
            </svg>
          </div><div t-else="" class="as-empty">No hay movimientos para este filtro.</div>
          <div class="as-legend"><span><i/> Ventas FA</span><span><i class="pink"/> Devoluciones DE</span></div>
        </article>
        <article class="as-panel"><div class="as-panel-head"><div><h2>Ventas por línea de producto</h2><p>Haz clic sobre una línea para filtrarla.</p></div><span class="as-tag">Ranking</span></div>
          <div class="as-ranks as-ranks-detailed"><t t-foreach="salesLines" t-as="r" t-key="r.name"><div class="as-rank"><div class="as-rank-top"><button type="button" class="as-rank-choice" t-att-data-line="r.name" t-on-click="onSelectLine" t-esc="r.name"/><strong><span class="as-net-prefix">Neto</span> <t t-esc="money(r.sales)"/></strong></div><div class="as-track"><div t-att-style="'width:' + width(r.sales, salesLines[0].sales)"/></div><div class="as-rank-kpis" aria-label="Detalle de facturación y venta">
                     <div class="as-rank-kpi"><span>Facturado FA</span><strong t-esc="money(r.fa_sales)"/></div>
                     <div class="as-rank-kpi"><span>Devuelto DE</span><strong t-esc="money(r.de_sales)"/></div>
                     <div class="as-rank-kpi is-net"><span>Neto vendido</span><strong t-esc="money(r.sales)"/></div>
                     <div class="as-rank-kpi"><span>Vendido FA</span><strong><t t-esc="num(r.fa_units)"/> uds.</strong></div>
                     <div class="as-rank-kpi is-return-units"><span>Unidades devueltas DE</span><strong><t t-esc="num(r.de_units)"/> uds.</strong></div>
                     <div class="as-rank-kpi is-net-units"><span>Unidades netas</span><strong><t t-esc="num(r.units)"/> uds.</strong></div>
                   </div><small><t t-esc="num(r.invoices)"/> facturas FA</small></div></t></div>
        </article>
      </div>
      <section class="as-panel as-section as-daily-panel" aria-label="Histórico de ventas netas diarias reales">
        <div class="as-panel-head as-daily-head">
          <div><h2>Ventas netas por día · histórico real</h2>
            <p>Ventas netas registradas (FA − DE) en los últimos días del período seleccionado. Se incluyen días sin movimientos con valor cero.</p>
          </div>
          <label class="as-history-control"><span>Días históricos</span>
            <input type="number" min="1" max="90" step="1" t-att-value="state.historyDays" t-on-change="onHistoryDays" aria-label="Cantidad de días históricos de ventas reales"/>
          </label>
        </div>
        <t t-if="dailyHistory &amp;&amp; dailyHistory.history.length">
          <div class="as-daily-summary">
            <div><span>Venta neta del historial</span><strong t-esc="money(dailyHistory.net_total)"/></div>
            <div><span>Promedio neto diario real</span><strong t-esc="money(dailyHistory.daily_average)"/></div>
            <div><span>Último día con movimientos</span><strong t-esc="dailyHistory.last_actual_day"/></div>
          </div>
          <div class="as-daily-scroll" tabindex="0" aria-label="Gráfico histórico de ventas netas reales desplazable lateralmente">
            <div class="as-daily-bars">
              <t t-foreach="dailyBars" t-as="p" t-key="p.date">
                <div class="as-daily-item" t-att-title="p.date + ' · Venta neta real ' + money(p.sales)">
                  <strong t-esc="money(p.sales)"/>
                  <div class="as-daily-track"><div t-att-class="p.sales &lt; 0 ? 'is-negative' : ''" t-att-style="'height:' + dailyBarHeight(p.sales)"/></div>
                  <small t-esc="dayShort(p.date)"/>
                </div>
              </t>
            </div>
          </div>
          <div class="as-daily-legend"><span><i class="is-real"/> Venta neta real FA − DE</span></div>
          <p class="as-muted-note">Solo se muestran movimientos reales de las fechas y locales autorizados. No se calculan ni registran ventas futuras.</p>
        </t>
        <div t-else="" class="as-empty">No hay ventas reales en el período y filtros seleccionados.</div>
      </section>
      <div class="as-grid-three as-section">
        <article class="as-panel as-panel-commercial" data-ranking="brands">
          <div class="as-panel-head"><div><h2>Marcas más vendidas</h2><p>Facturado, vendido y neto por marca.</p></div><span class="as-tag">Top 7</span></div>
          <div class="as-ranks as-ranks-expanded" aria-label="Marcas más vendidas con facturación, ventas y neto">
            <t t-foreach="salesBrands" t-as="r" t-key="r.name">
              <div class="as-rank as-rank-commercial">
                <div class="as-rank-top"><strong class="as-rank-name" t-esc="r.name" t-att-title="r.name"/><strong class="as-rank-main"><span class="as-rank-main-label">Neto</span> <t t-esc="money(r.sales)"/></strong></div>
                <div class="as-track pink"><div t-att-style="'width:' + width(r.sales, salesBrands[0].sales)"/></div>
                <div class="as-rank-financials" aria-label="Datos comerciales detallados">
                  <div class="as-financial-cell as-financial-sold"><span>Vendido FA</span><strong><t t-esc="num(r.fa_units)"/> uds.</strong></div>
                  <div class="as-financial-cell"><span>Facturado FA</span><strong t-esc="money(r.fa_sales)"/></div>
                  <div class="as-financial-cell as-financial-net"><span>Neto vendido</span><strong t-esc="money(r.sales)"/></div>
                  <div class="as-financial-cell as-financial-return"><span>Devuelto DE</span><strong t-esc="money(r.de_sales)"/></div>
                  <div class="as-financial-cell as-financial-return-units"><span>Unidades devueltas DE</span><strong><t t-esc="num(r.de_units)"/> uds.</strong></div>
                  <div class="as-financial-cell as-financial-net-units"><span>Unidades netas</span><strong><t t-esc="num(r.units)"/> uds.</strong></div>
                </div>
              </div>
            </t>
            <div t-if="!salesBrands.length" class="as-empty">No hay datos para los filtros seleccionados.</div>
          </div>
        </article>
        <article class="as-panel as-panel-commercial" data-ranking="sellers">
          <div class="as-panel-head"><div><h2>Vendedores destacados</h2><p>Facturado, vendido y neto por vendedor.</p></div><span class="as-tag">Top 5</span></div>
          <div class="as-ranks as-ranks-expanded" aria-label="Vendedores destacados con facturación, ventas y neto">
            <t t-foreach="salesSellers" t-as="r" t-key="r.name">
              <div class="as-rank as-rank-commercial">
                <div class="as-rank-top"><strong class="as-rank-name" t-esc="r.name" t-att-title="r.name"/><strong class="as-rank-main"><span class="as-rank-main-label">Neto</span> <t t-esc="money(r.sales)"/></strong></div>
                <div class="as-track "><div t-att-style="'width:' + width(r.sales, salesSellers[0].sales)"/></div>
                <div class="as-rank-financials" aria-label="Datos comerciales detallados">
                  <div class="as-financial-cell as-financial-sold"><span>Vendido FA</span><strong><t t-esc="num(r.fa_units)"/> uds.</strong></div>
                  <div class="as-financial-cell"><span>Facturado FA</span><strong t-esc="money(r.fa_sales)"/></div>
                  <div class="as-financial-cell as-financial-net"><span>Neto vendido</span><strong t-esc="money(r.sales)"/></div>
                  <div class="as-financial-cell as-financial-return"><span>Devuelto DE</span><strong t-esc="money(r.de_sales)"/></div>
                  <div class="as-financial-cell as-financial-return-units"><span>Unidades devueltas DE</span><strong><t t-esc="num(r.de_units)"/> uds.</strong></div>
                  <div class="as-financial-cell as-financial-net-units"><span>Unidades netas</span><strong><t t-esc="num(r.units)"/> uds.</strong></div>
                </div>
              </div>
            </t>
            <div t-if="!salesSellers.length" class="as-empty">No hay datos para los filtros seleccionados.</div>
          </div>
        </article>
        <article class="as-panel as-panel-commercial" data-ranking="velocity">
          <div class="as-panel-head"><div><h2>Mayor velocidad de venta</h2><p>Unidades por día, más facturado y neto por SKU.</p></div><span class="as-tag">Uds./día</span></div>
          <div class="as-ranks as-ranks-expanded" aria-label="Mayor velocidad de venta con facturación, ventas y neto">
            <t t-foreach="velocityProducts" t-as="r" t-key="r.name">
              <div class="as-rank as-rank-commercial">
                <div class="as-rank-top"><strong class="as-rank-name" t-esc="r.name" t-att-title="r.name"/><strong class="as-rank-main"><span class="as-rank-main-label">Uds./día</span> <t t-esc="num(r.velocity)"/></strong></div>
                <div class="as-track "><div t-att-style="'width:' + width(r.velocity, velocityProducts[0].velocity)"/></div>
                <div class="as-rank-financials" aria-label="Datos comerciales detallados">
                  <div class="as-financial-cell as-financial-sold"><span>Vendido FA</span><strong><t t-esc="num(r.fa_units)"/> uds.</strong></div>
                  <div class="as-financial-cell"><span>Facturado FA</span><strong t-esc="money(r.fa_sales)"/></div>
                  <div class="as-financial-cell as-financial-net"><span>Neto vendido</span><strong t-esc="money(r.sales)"/></div>
                  <div class="as-financial-cell as-financial-return"><span>Devuelto DE</span><strong t-esc="money(r.de_sales)"/></div>
                  <div class="as-financial-cell as-financial-return-units"><span>Unidades devueltas DE</span><strong><t t-esc="num(r.de_units)"/> uds.</strong></div>
                  <div class="as-financial-cell as-financial-net-units"><span>Unidades netas</span><strong><t t-esc="num(r.units)"/> uds.</strong></div>
                </div>
              </div>
            </t>
            <div t-if="!velocityProducts.length" class="as-empty">No hay datos para los filtros seleccionados.</div>
          </div>
        </article>
      </div>
      <section class="as-invoice-section"><div class="as-section-heading"><div><div class="as-eyebrow">GESTIÓN DE FACTURACIÓN</div><h2>Facturas, productividad y decisión comercial</h2><p>Comprobantes únicos FA (no líneas de detalle). Los documentos DE se muestran por separado.</p></div><span class="as-tag">Por nlocal y vendedor</span></div>
        <div class="as-grid-main as-section">
          <article class="as-panel"><div class="as-panel-head"><div><h2>Productividad por vendedor</h2><p>Facturas FA, ticket, unidades y ventas netas para el período seleccionado.</p></div><span class="as-tag">Vendedores</span></div>
            <div class="as-table-wrap as-sales-scroll-table as-seller-scroll" tabindex="0" aria-label="Productividad por vendedor: tabla desplazable vertical y horizontalmente"><table><thead><tr><th>Vendedor</th><th class="as-num">Facturas FA</th><th class="as-num">Vendido FA (uds.)</th><th class="as-num">Unidades devueltas DE</th><th class="as-num">Unidades netas</th><th class="as-num">Facturado FA</th><th class="as-num">Devuelto DE</th><th class="as-num">Venta neta</th><th class="as-num">Ticket FA</th><th t-if="isAdmin" class="as-num">Utilidad</th></tr></thead><tbody><t t-foreach="sellerInvoices" t-as="r" t-key="r.name"><tr><td t-esc="r.name"/><td class="as-num" t-esc="num(r.invoices)"/><td class="as-num" t-esc="num(r.fa_units)"/><td class="as-num" t-esc="num(r.de_units)"/><td class="as-num" t-esc="num(r.units)"/><td class="as-num" t-esc="money(r.fa_sales)"/><td class="as-num" t-esc="money(r.de_sales)"/><td class="as-num" t-esc="money(r.sales)"/><td class="as-num" t-esc="money(r.ticket)"/><td t-if="isAdmin" class="as-num" t-esc="money(r.profit)"/></tr></t></tbody></table></div>
          </article>
          <article class="as-panel"><div class="as-panel-head"><div><h2>Facturas emitidas por mes</h2><p>Documentos FA distintos por mes, y ticket promedio.</p></div><span class="as-tag">Tendencia</span></div>
            <div class="as-invoice-trend"><t t-foreach="invoiceMonths" t-as="r" t-key="r.month"><div class="as-invoice-line"><span class="as-invoice-label" t-esc="r.month.slice(5) + '/' + r.month.slice(2,4)"/><div class="as-track"><div t-att-style="'width:' + width(r.invoices, maxInvoices)"/></div><strong t-esc="num(r.invoices)"/><small><t t-esc="money(r.fa_sales)"/> FA · Ticket <t t-esc="money(r.ticket)"/></small></div></t></div>
          </article>
        </div>
        <article class="as-panel as-section"><div class="as-panel-head"><div><h2>Alertas para decisiones</h2><p>Señales del período y ámbito elegidos; no son metas ni diagnósticos de inventario.</p></div><span class="as-tag">Acciones sugeridas</span></div>
          <div class="as-decision-list"><t t-foreach="decisions" t-as="item" t-key="item.label"><div t-att-class="'as-decision ' + item.kind"><span t-esc="item.label"/><strong t-esc="item.title"/><p t-esc="item.detail"/></div></t></div>
        </article>
      </section>
      <section class="as-spotlight" t-if="roleInsights.length"><div class="as-spotlight-head"><span class="as-spotlight-kicker">HALLAZGOS DESTACADOS · <t t-esc="isAdmin ? 'Administración' : isSupervisor ? 'Supervisión' : 'Tu tienda'"/></span><span class="as-tag">Inteligencia comercial</span></div><div class="as-spotlight-grid"><t t-foreach="roleInsights" t-as="r" t-key="r.label"><div><span t-esc="r.label"/><strong t-esc="r.title"/><small t-esc="r.detail"/></div></t></div></section>
      <div class="as-grid-main as-section">
        <article class="as-panel"><div class="as-panel-head"><div><h2>Clasificación ABC por ventas netas</h2><p>Prioridad de modelos según participación acumulada en ventas netas positivas. A: 80% · B: 15% · C: 5%. Los movimientos sin modelo se reúnen en un grupo Sin modelo.</p></div><span class="as-tag">ABC comercial</span></div>
          <div class="as-abc-list"><t t-foreach="abcBreakdown" t-as="r" t-key="r.label"><div class="as-abc-row"><div class="as-abc-name"><span t-att-class="'as-abc-pill abc-' + r.label" t-esc="r.label"/><span><strong><t t-esc="num(r.products)"/> Modelo</strong><small><t t-esc="pct(r.share)"/> de ventas netas positivas</small></span></div><strong t-esc="money(r.sales)"/></div></t></div>
        </article>
        <article class="as-panel"><div class="as-panel-head"><div><h2>Líneas con más devoluciones</h2><p>Valor DE / facturación FA por línea. No corresponde a una tasa de cohorte.</p></div><span class="as-tag">Calidad de ventas</span></div>
          <div class="as-ranks"><t t-foreach="returnLines" t-as="r" t-key="r.name"><div class="as-rank"><div class="as-rank-top"><strong class="as-rank-name" t-esc="r.name"/><strong t-esc="pct(r.return_rate)"/></div><div class="as-track pink"><div t-att-style="'width:' + width(r.return_rate, returnLines[0].return_rate)"/></div><small><t t-esc="money(r.de_sales)"/> devueltos · <t t-esc="num(r.de_units)"/> unidades DE</small></div></t><div t-if="!returnLines.length" class="as-empty">No hay devoluciones DE en este filtro.</div></div>
        </article>
      </div>
      <div class="as-section">
        <article class="as-panel"><div class="as-panel-head"><div><h2>Productos más vendidos</h2><p>Ranking por modelo: suma de unidades y ventas de todos sus SKU. Los movimientos sin modelo se agrupan como Sin modelo.</p></div><span class="as-tag">Top 8 modelos</span></div>
          <div class="as-table-wrap"><table><thead><tr><th>Modelo</th><th>ABC</th><th class="as-num">Vendido FA (uds.)</th><th class="as-num">Unidades devueltas DE</th><th class="as-num">Unidades netas</th><th class="as-num">Facturado FA</th><th class="as-num">Devuelto DE</th><th class="as-num">Venta neta</th></tr></thead><tbody><t t-foreach="productTable" t-as="r" t-key="r.name"><tr><td t-esc="r.name"/><td><span class="as-ordinal" t-esc="r.abc"/></td><td class="as-num" t-esc="num(r.fa_units)"/><td class="as-num" t-esc="num(r.de_units)"/><td class="as-num" t-esc="num(r.units)"/><td class="as-num" t-esc="money(r.fa_sales)"/><td class="as-num" t-esc="money(r.de_sales)"/><td class="as-num" t-esc="money(r.sales)"/></tr></t></tbody></table></div>
        </article>
        
      </div>
      <div class="as-grid-main as-section">
        <article class="as-panel"><div class="as-panel-head"><div><h2>Desglose FA / DE</h2><p>Impacto de las devoluciones en la venta efectiva.</p></div><span class="as-tag">Movimientos</span></div>
          <div class="as-breakdown"><t t-foreach="breakdown" t-as="r" t-key="r.label"><div class="as-breakdown-row"><span><i t-att-class="'as-dot-' + r.accent"/><t t-esc="r.label"/></span><strong t-esc="money(r.value)"/></div></t></div><p class="as-muted-note"><t t-esc="num(state.data.metrics.credit_notes)"/> notas DE únicas · <t t-esc="num(state.data.metrics.de_units)"/> unidades devueltas.</p>
        </article>
        <article class="as-panel" t-if="isAdmin"><div class="as-panel-head"><div><h2>Rentabilidad por marca</h2><p>Utilidad y margen para detectar las marcas que aportan más.</p></div><span class="as-tag">Análisis</span></div>
          <div class="as-table-wrap as-sales-scroll-table as-brand-scroll" tabindex="0" aria-label="Rentabilidad por marca: tabla desplazable vertical y horizontalmente"><table><thead><tr><th>Marca</th><th class="as-num">Vendido FA (uds.)</th><th class="as-num">Unidades devueltas DE</th><th class="as-num">Facturado FA</th><th class="as-num">Devuelto DE</th><th class="as-num">Venta neta</th><th class="as-num">Utilidad</th><th class="as-num">Margen</th></tr></thead><tbody><t t-foreach="profitBrands" t-as="r" t-key="r.name"><tr><td t-esc="r.name"/><td class="as-num" t-esc="num(r.fa_units)"/><td class="as-num" t-esc="num(r.de_units)"/><td class="as-num" t-esc="money(r.fa_sales)"/><td class="as-num" t-esc="money(r.de_sales)"/><td class="as-num" t-esc="money(r.sales)"/><td class="as-num" t-esc="money(r.profit)"/><td class="as-num" t-esc="pct(r.margin)"/></tr></t></tbody></table></div><p t-if="!hasCompleteCosts" class="as-muted-note">Los márgenes se omiten donde existen costos incompletos.</p>
        </article>
        <article class="as-panel" t-else=""><div class="as-panel-head"><div><h2>Aporte por marca</h2><p>Unidades y ventas netas sin mostrar costos.</p></div><span class="as-tag">Comercial</span></div>
          <div class="as-table-wrap"><table><thead><tr><th>Marca</th><th class="as-num">Vendido FA (uds.)</th><th class="as-num">Unidades devueltas DE</th><th class="as-num">Unidades netas</th><th class="as-num">Facturado FA</th><th class="as-num">Devuelto DE</th><th class="as-num">Venta neta</th></tr></thead><tbody><t t-foreach="salesBrands" t-as="r" t-key="r.name"><tr><td t-esc="r.name"/><td class="as-num" t-esc="num(r.fa_units)"/><td class="as-num" t-esc="num(r.de_units)"/><td class="as-num" t-esc="num(r.units)"/><td class="as-num" t-esc="money(r.fa_sales)"/><td class="as-num" t-esc="money(r.de_sales)"/><td class="as-num" t-esc="money(r.sales)"/></tr></t></tbody></table></div>
        </article>
      </div>
      <footer class="as-footer"><span><strong><t t-esc="brandTitle"/> · Dashboard gerencial · Odoo 18.</strong> Locales derivados de nlocal; facturas distintas por tipo + nlocal + número.</span><span><strong>Seguridad:</strong> los perfiles se validan en el servidor Odoo. <t t-esc="state.data.limitations"/></span></footer>
    </t>
  </div>
  <div t-if="state.guideOpen" class="as-modal-backdrop" role="presentation"><div class="as-modal" role="dialog" aria-modal="true" aria-label="Reglas del dashboard"><div class="as-modal-head"><h2>Reglas del dashboard</h2><button type="button" class="as-button" t-on-click="onCloseGuide" aria-label="Cerrar ventana">✕</button></div><div class="as-modal-body"><p><strong>FA = factura (venta).</strong> <strong>DE = devolución.</strong> Los importes de devolución se restan una sola vez del total de facturación.</p><table><thead><tr><th>Métrica</th><th>Definición</th></tr></thead><tbody><tr><td>Venta neta</td><td>Ventas FA menos devoluciones DE.</td></tr><tr><td>Unidades netas</td><td>Unidades FA menos unidades DE.</td></tr><tr><td>Facturas FA</td><td>Comprobantes únicos por tipo, local nlocal y número; no por SKU.</td></tr><tr><td>Ticket FA</td><td>Importe total FA dividido entre facturas FA únicas.</td></tr><tr><td>Facturado FA</td><td>Suma del importe de las líneas de factura FA antes de restar devoluciones.</td></tr><tr><td>Devuelto DE</td><td>Suma de los importes absolutos de las notas de devolución DE.</td></tr><tr><td>Neto vendido</td><td>Facturado FA menos Devuelto DE.</td></tr><tr><td>Vendido FA (uds.)</td><td>Unidades facturadas FA antes de restar las unidades devueltas DE.</td></tr><tr><td>Unidades devueltas DE</td><td>Cantidad devuelta en notas DE del período y filtros seleccionados.</td></tr><tr><td>Unidades netas</td><td>Vendido FA (uds.) menos unidades devueltas DE.</td></tr><tr><td>ABC</td><td>Por modelo, según ventas netas positivas acumuladas: A ~80%, B ~15%, C ~5%.</td></tr><tr><td>Velocidad comercial</td><td>Unidades netas / días calendario del rango; no mide rotación de inventario.</td></tr><tr><td>Histórico diario</td><td>Ventas netas reales FA − DE de los últimos N días calendario del período, incluidos días sin movimientos. No incluye proyecciones futuras.</td></tr><tr><td>Utilidad / margen</td><td>Exclusivo Administrador. Depende de costos disponibles y completos.</td></tr></tbody></table><p><strong>Ámbito de análisis:</strong> <t t-esc="scopeDescription"/> <strong>Seguridad:</strong> los accesos a costos y locales se restringen desde Odoo, no sólo visualmente.</p></div></div></div>
</div>
</t>
</templates>
