<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_analytics_sales_warehouses" model="ir.cron">
            <field name="name">Analytics Sales | Actualizar bodegas</field>
            <field name="model_id" ref="model_analytics_sales_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_warehouses()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <!-- Update existing noupdate job too; do not recreate it. -->
    <function model="analytics.sales.sync" name="configure_warehouse_cron"/>
</odoo>
