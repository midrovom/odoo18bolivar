<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- The legacy ir_cron_analytics_sales_sync is deactivated by configure_crons. -->
        <record id="ir_cron_analytics_sales_anuales" model="ir.cron">
            <field name="name">Analytics Sales | Ventas anuales |</field>
            <field name="model_id" ref="model_analytics_sales_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_anuales()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_analytics_sales_mensuales" model="ir.cron">
            <field name="name">Analytics Sales | Ventas mensuales |</field>
            <field name="model_id" ref="model_analytics_sales_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_mensuales()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <!-- Runs on install and update: schedule local times and retire the old two-hour cron. -->
    <function model="analytics.sales.sync" name="configure_crons"/>
</odoo>
