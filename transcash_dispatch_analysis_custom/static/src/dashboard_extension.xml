<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="transcash_dispatch_analysis_custom.DashboardExtension" t-inherit="transcash_dispatch_analysis.Dashboard" t-inherit-mode="extension">
    <xpath expr="//table[contains(@class, 'td-delay-table')]//button[@t-esc='invoice.name']" position="attributes">
      <attribute name="t-esc">invoice.custom_external_label || invoice.name</attribute>
    </xpath>
    <xpath expr="//section[contains(@class, 'td-agreements')]" position="before"><div class="td-monthly-section" t-if="state.data.monthly">
          <div class="td-section-header"><div><h2>Estadísticas mensuales · <t t-esc="state.data.monthly.year"/></h2><p>Enero a diciembre · Año de la fecha Hasta (o Desde si no hay Hasta; sin fechas, año del corte seleccionado o actual); mismos filtros de fuente, corte, ciudad, modalidad y bodegas.</p></div></div>
          <div t-if="!state.data.monthly.available" class="td-panel td-alert warning" t-esc="state.data.monthly.reason"/>
          <t t-else="">
            <section class="td-panel td-wide td-monthly-panel">
              <div class="td-section-header"><div><h3>Despachos realizados y % de retraso</h3><p>Por fecha de despacho completo · Una factura por despacho</p></div><div class="td-monthly-total"><span>Despachos del año</span><strong t-esc="format(state.data.monthly.completed_total)"/></div></div>
              <div class="td-monthly-legend"><span><i class="td-monthly-blue"/>Despachos realizados</span><span><i class="td-monthly-red"/>% de retraso</span></div>
              <div class="td-monthly-scroll">
                <svg viewBox="0 0 930 278" class="td-monthly-svg" role="img" aria-label="Despachos completos y porcentaje de retraso por mes">
                  <g t-foreach="monthlyAxis('completed').ticks" t-as="tick" t-key="tick.value">
                    <line x1="48" x2="875" t-att-y1="tick.y" t-att-y2="tick.y" class="td-monthly-gridline"/>
                    <text x="42" t-att-y="tick.y + 4" text-anchor="end" class="td-monthly-axis" t-esc="format(tick.value)"/>
                    <text x="883" t-att-y="tick.y + 4" class="td-monthly-axis td-monthly-percent" t-esc="tick_index * 25 + '%'"/>
                  </g>
                  <g t-foreach="monthlyPoints()" t-as="point" t-key="point.month">
                    <title t-esc="monthlyTooltip(point)"/>
                    <rect t-att-x="point.x - 20" t-att-y="point.y" width="40" t-att-height="point.height" rx="3" class="td-monthly-blue"/>
                    <text t-att-x="point.x" t-att-y="point.y - 6" text-anchor="middle" class="td-monthly-count" t-esc="format(point.completed)"/>
                    <text t-att-x="point.x" y="250" text-anchor="middle" class="td-monthly-axis" t-esc="point.label"/>
                  </g>
                  <polyline t-foreach="monthlyDelaySegments()" t-as="segment" t-key="segment_index" t-att-points="segment" fill="none" class="td-monthly-line" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <g t-foreach="monthlyPoints().filter(p =&gt; p.lateY !== null)" t-as="point" t-key="point.month">
                    <title t-esc="monthlyTooltip(point)"/>
                    <circle t-att-cx="point.x" t-att-cy="point.lateY" r="4" class="td-monthly-red" stroke="white" stroke-width="1.5"/>
                    <text t-att-x="point.x" t-att-y="point.lateLabelY" text-anchor="middle" class="td-monthly-percent td-monthly-value" t-esc="format(point.late_pct, 1) + '%'"/>
                  </g>
                </svg>
              </div>
            </section>
            <section class="td-panel td-wide td-monthly-panel">
              <div class="td-section-header"><div><h3>Despachos pendientes acumulados</h3><p>Por mes de facturación · Pendientes al corte seleccionado</p></div><div class="td-monthly-total"><span>Pendientes del año</span><strong t-esc="format(state.data.monthly.pending_total)"/></div></div>
              <div class="td-monthly-legend"><span><i class="td-monthly-carry"/>Pendientes de meses anteriores</span><span><i class="td-monthly-amber"/>Pendientes del mes</span></div>
              <div class="td-monthly-scroll">
                <svg viewBox="0 0 930 278" class="td-monthly-svg" role="img" aria-label="Despachos pendientes del mes y acumulados de enero a diciembre">
                  <g t-foreach="monthlyAxis('pending_accumulated').ticks" t-as="tick" t-key="tick.value">
                    <line x1="48" x2="875" t-att-y1="tick.y" t-att-y2="tick.y" class="td-monthly-gridline"/>
                    <text x="42" t-att-y="tick.y + 4" text-anchor="end" class="td-monthly-axis" t-esc="format(tick.value)"/>
                  </g>
                  <g t-foreach="monthlyPoints(true)" t-as="point" t-key="point.month">
                    <title t-esc="monthlyTooltip(point, true)"/>
                    <rect t-att-x="point.x - 20" t-att-y="point.y + point.newHeight" width="40" t-att-height="Math.max(0, point.height - point.newHeight)" class="td-monthly-carry"/>
                    <rect t-att-x="point.x - 20" t-att-y="point.y" width="40" t-att-height="point.newHeight" class="td-monthly-amber"/>
                    <text t-att-x="point.x" t-att-y="point.y - 7" text-anchor="middle" class="td-monthly-count" t-esc="format(point.pending_accumulated)"/>
                    <text t-att-x="point.x" y="250" text-anchor="middle" class="td-monthly-axis" t-esc="point.label"/>
                    <text t-att-x="point.x" y="267" text-anchor="middle" class="td-monthly-new" t-esc="'+' + format(point.pending)"/>
                  </g>
                </svg>
              </div>
            </section>
          </t>
        </div>
        </xpath>
  </t>
</templates>
