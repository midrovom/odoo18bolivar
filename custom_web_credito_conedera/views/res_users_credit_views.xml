<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Retain this xmlid to deactivate the old inherited view on module upgrade.
         The only permission control is now the standard res.groups checkbox. -->
    <record id="view_users_credit_correction_inherit" model="ir.ui.view">
        <field name="name">res.users.form.credit.portal.permissions.legacy.disabled</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="o_credit_legacy_permission_hidden" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
