<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_conedera_credit_applicant_type_list" model="ir.ui.view">
        <field name="name">conedera.credit.applicant.type.list</field>
        <field name="model">conedera.credit.applicant.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de solicitante" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" string="ID único" readonly="1"/>
                <field name="active"/>
                <field name="application_count" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_conedera_credit_applicant_type_form" model="ir.ui.view">
        <field name="name">conedera.credit.applicant.type.form</field>
        <field name="model">conedera.credit.applicant.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de solicitante">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Ej.: Asociación"/></h1></div>
                    <group><field name="code" readonly="1"/><field name="sequence"/><field name="active"/><field name="application_count" readonly="1"/></group>
                    <group><field name="note" placeholder="Instrucciones que verá el solicitante en el portal de documentos"/></group>
                    <notebook><page string="Documentos exigidos">
                        <field name="requirement_ids" context="{'default_applicant_type_id': id}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="required"/>
                                <field name="only_if_spouse"/>
                                <field name="image_only"/>
                                <field name="active"/>
                            </list>
                            <form><sheet><group>
                                <field name="name"/>
                                <field name="applicant_type_id" invisible="1"/>
                                <field name="required"/>
                                <field name="only_if_spouse"/>
                                <field name="image_only"/>
                                <field name="active"/>
                                <field name="sequence"/>
                                <field name="description"/>
                            </group></sheet></form>
                        </field>
                    </page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_conedera_credit_applicant_types" model="ir.actions.act_window">
        <field name="name">Tipos de solicitante y documentos</field>
        <field name="res_model">conedera.credit.applicant.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_conedera_credit_applicant_types" name="Tipos de solicitante" parent="menu_conedera_credit_root"
              action="action_conedera_credit_applicant_types" sequence="35" groups="custom_web_credito_conedera.group_credit_manager"/>
</odoo>
