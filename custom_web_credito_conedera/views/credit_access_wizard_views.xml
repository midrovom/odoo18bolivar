<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_conedera_credit_access_wizard_form" model="ir.ui.view">
        <field name="name">conedera.credit.access.wizard.form</field>
        <field name="model">conedera.credit.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Acceso especial a la solicitud">
                <group>
                    <field name="application_id" readonly="1"/>
                    <field name="document_access_allowed" invisible="1"/>
                    <field name="destination" widget="radio"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="document_access_allowed">
                    Los documentos solo se habilitan al aprobar la solicitud.
                </div>
                <footer>
                    <button name="action_open" type="object" string="Abrir sección" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
