<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_conedera_credit_application_search" model="ir.ui.view">
        <field name="name">conedera.credit.application.search</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><search string="Buscar solicitudes de crédito"><field name="name"/><field name="applicant_name"/><field name="identification"/><field name="business_name"/><field name="business_ruc"/><field name="applicant_type_id"/><field name="stage_id"/><filter string="Documentos habilitados" name="docs_unlocked" domain="['|',('stage_id.is_approved','=',True),('stage_id.is_documents_received','=',True)]"/><group expand="0" string="Agrupar por"><filter string="Etapa" name="group_stage" context="{'group_by':'stage_id'}"/><filter string="Tipo de solicitante" name="group_person" context="{'group_by':'applicant_type_id'}"/><filter string="Fecha de solicitud" name="group_date" context="{'group_by':'application_date:month'}"/></group></search></field>
    </record>
    <record id="view_conedera_credit_application_list" model="ir.ui.view">
        <field name="name">conedera.credit.application.list</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><list string="Solicitudes de crédito" default_order="create_date desc"><field name="name"/><field name="application_date"/><field name="applicant_name"/><field name="identification"/><field name="business_name"/><field name="applicant_type_id"/><field name="stage_id"/><field name="verification_status" optional="show"/><field name="document_access_allowed" optional="show"/><field name="document_complete" optional="show"/><field name="portal_user_id" optional="hide"/></list></field>
    </record>
    <record id="view_conedera_credit_application_kanban" model="ir.ui.view">
        <field name="name">conedera.credit.application.kanban</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false" records_draggable="true"><field name="name"/><field name="applicant_name"/><field name="business_name"/><field name="applicant_type_id"/><field name="identification_type"/><field name="identification"/><field name="application_date"/><field name="stage_id"/><field name="document_access_allowed"/><field name="document_complete"/><templates><t t-name="card"><div class="oe_kanban_global_click o_kanban_record"><div class="d-flex justify-content-between align-items-start"><strong><field name="name"/></strong><field name="applicant_type_id"/></div><div class="mt-2 fw-bold"><field name="business_name"/></div><div class="text-muted"><field name="applicant_name"/></div><div class="small mt-2">Identificación: <field name="identification"/></div><div class="small">Fecha: <field name="application_date"/></div><div class="mt-2"><field name="document_access_allowed" widget="boolean"/> <span class="text-muted">Carga documental habilitada</span></div><div t-if="record.document_complete.raw_value" class="mt-2"><span class="badge text-bg-success">Documentación completa</span></div><div t-else="" class="mt-2"><span class="badge text-bg-secondary">Documentación pendiente</span></div></div></t></templates></kanban></field>
    </record>
    <record id="view_conedera_credit_application_form" model="ir.ui.view">
        <field name="name">conedera.credit.application.form</field><field name="model">conedera.credit.application</field>
        <field name="arch" type="xml"><form string="Solicitud de crédito CONEDERA">
            <header><button name="action_print_credit_application" type="object" string="Descargar solicitud PDF" icon="fa-file-pdf-o" class="btn-secondary" groups="custom_web_credito_conedera.group_credit_manager"/><field name="document_complete" invisible="1" readonly="not credit_is_admin"/><field name="document_access_allowed" invisible="1" readonly="not credit_is_admin"/><field name="credit_access_button_visible" invisible="1" readonly="not credit_is_admin"/><button name="action_open_portal_update_wizard" type="object" string="Habilitar permiso del portal" class="btn-primary" groups="custom_web_credito_conedera.group_credit_portal_update_manager" invisible="not credit_access_button_visible"/><field name="stage_id" widget="statusbar" options="{'clickable': 1}"/><button name="action_mark_documentation_received" type="object" string="Marcar documentación recibida" class="btn-primary" invisible="not document_access_allowed or document_complete == False" groups="custom_web_credito_conedera.group_credit_administrator"/></header>
            <sheet>
                <field name="credit_is_admin" invisible="1"/><div class="oe_button_box" name="button_box"><button name="action_open_portal_update_wizard" type="object" class="oe_stat_button" icon="fa-key" groups="custom_web_credito_conedera.group_credit_portal_update_manager" invisible="not credit_access_button_visible"><div class="o_stat_info"><span class="o_stat_text">Permiso portal</span></div></button></div>
                <div class="oe_title"><label for="name"/><h1><field name="name" readonly="not credit_is_admin"/></h1><div class="text-muted">Solicitud enviada desde el portal CONEDERA</div></div>
                <group><group><field name="application_date" readonly="not credit_is_admin"/><field name="application_place" readonly="not credit_is_admin"/><field name="portal_user_id" readonly="not credit_is_admin"/><field name="portal_update_scope" readonly="1"/><field name="portal_update_allowed_at" readonly="1"/><field name="portal_update_allowed_by" readonly="1"/><field name="portal_history_consumed_at" readonly="1"/><field name="applicant_type_id" readonly="not credit_is_admin"/><field name="identification_type" readonly="not credit_is_admin"/><field name="identification" readonly="not credit_is_admin"/><field name="declaration_accepted" readonly="not credit_is_admin"/><field name="prior_commercial_relationship_accepted" readonly="not credit_is_admin"/><field name="electronic_service_accepted" readonly="not credit_is_admin"/><field name="credit_bureau_authorized" readonly="not credit_is_admin"/><field name="company_signature_stamp_acknowledged" readonly="not credit_is_admin"/><field name="additional_financial_documents_accepted" readonly="not credit_is_admin"/><field name="declaration_date" readonly="not credit_is_admin"/></group><group><field name="applicant_name" readonly="not credit_is_admin"/><field name="applicant_email" readonly="not credit_is_admin"/><field name="mobile" readonly="not credit_is_admin"/><field name="phone_fixed" readonly="not credit_is_admin"/><field name="document_access_allowed" readonly="not credit_is_admin"/><field name="currency_id" groups="base.group_system" readonly="not credit_is_admin"/></group></group>
                <notebook>
                    <page string="Propietario o representante">
                        <group><group><field name="profession" readonly="not credit_is_admin"/><field name="marital_status_id" readonly="not credit_is_admin"/><field name="foreign_residence_time" readonly="not credit_is_admin"/><field name="foreign_work_visa" readonly="not credit_is_admin"/><field name="spouse_name" readonly="not credit_is_admin"/><field name="spouse_identification" readonly="not credit_is_admin"/><field name="spouse_profession" readonly="not credit_is_admin"/><field name="dependents_count" readonly="not credit_is_admin"/></group><group><field name="home_address" readonly="not credit_is_admin"/><field name="housing_type_id" readonly="not credit_is_admin"/></group></group>
                    </page>
                    <page string="Vehículos del solicitante">
                        <field name="vehicle_ids" context="{'default_application_id': id}" readonly="not credit_is_admin">
                            <list editable="bottom"><field name="sequence" widget="handle"/><field name="brand"/><field name="model"/><field name="year"/><field name="value"/></list>
                            <form string="Vehículo"><group><field name="brand"/><field name="model"/><field name="year"/><field name="value"/></group></form>
                        </field>
                    </page>
                    <page string="Negocio o empresa">
                        <group><group><field name="business_name" readonly="not credit_is_admin"/><field name="legal_representative" readonly="not credit_is_admin"/><field name="business_ruc" readonly="not credit_is_admin"/><field name="province" readonly="not credit_is_admin"/><field name="canton" readonly="not credit_is_admin"/><field name="city" readonly="not credit_is_admin"/><field name="business_address" readonly="not credit_is_admin"/></group><group><field name="business_phone" readonly="not credit_is_admin"/><field name="representative_email" readonly="not credit_is_admin"/><field name="activity_start_date" readonly="not credit_is_admin"/><field name="business_local_type" readonly="not credit_is_admin"/><field name="business_latitude" readonly="not credit_is_admin"/><field name="business_longitude" readonly="not credit_is_admin"/><field name="invoice_email" readonly="not credit_is_admin"/></group></group>
                        <group string="Información económica"><group><field name="monthly_sales" readonly="not credit_is_admin"/><field name="social_capital" readonly="not credit_is_admin"/><field name="assets_amount" readonly="not credit_is_admin"/><field name="liabilities_amount" readonly="not credit_is_admin"/></group><group><field name="monthly_income" readonly="not credit_is_admin"/><field name="monthly_expenses" readonly="not credit_is_admin"/><field name="authorized_buyer_name" readonly="not credit_is_admin"/><field name="authorized_buyer_identification" readonly="not credit_is_admin"/><field name="authorized_buyer_email" readonly="not credit_is_admin"/><field name="authorized_pickup_name" readonly="not credit_is_admin"/><field name="authorized_pickup_identification" readonly="not credit_is_admin"/></group></group>
                    </page>
                    <page string="Relación de dependencia"><group><group><field name="employment_company" readonly="not credit_is_admin"/><field name="employment_activity" readonly="not credit_is_admin"/><field name="employment_address" readonly="not credit_is_admin"/><field name="employment_phone" readonly="not credit_is_admin"/></group><group><field name="employment_start_date" readonly="not credit_is_admin"/><field name="employment_position" readonly="not credit_is_admin"/><field name="employment_salary" readonly="not credit_is_admin"/></group></group></page>
                    <page string="Referencias"><field name="reference_ids" context="{'default_application_id': id}" readonly="not credit_is_admin"><list editable="bottom"><field name="sequence" widget="handle"/><field name="reference_type"/><field name="provider" optional="show"/><field name="customer_since" optional="hide"/><field name="credit_limit" optional="hide"/><field name="term" optional="hide"/><field name="phone" optional="show"/><field name="contact" optional="hide"/><field name="person_name" optional="show"/><field name="address" optional="hide"/><field name="home_phone" optional="hide"/><field name="relationship" optional="hide"/><field name="bank_name" optional="show"/><field name="account_number" optional="hide"/><field name="opening_date" optional="hide"/><field name="account_type" optional="hide"/></list><form><group><field name="reference_type"/><field name="sequence"/><group string="Referencia comercial" invisible="reference_type != 'commercial'"><field name="provider"/><field name="customer_since"/><field name="credit_limit"/><field name="term"/><field name="phone"/><field name="contact"/></group><group string="Referencia personal" invisible="reference_type != 'personal'"><field name="person_name"/><field name="address"/><field name="home_phone"/><field name="relationship"/></group><group string="Referencia bancaria" invisible="reference_type != 'bank'"><field name="bank_name"/><field name="account_number"/><field name="opening_date"/><field name="account_type"/></group></group></form></field></page>
                    <page string="Ingreso de documentos" invisible="not document_access_allowed">
                        <field name="document_ids" context="{'default_application_id': id}" readonly="not credit_is_admin">
                            <list create="0" delete="0"><field name="state"/><field name="required_document_uploaded"/><field name="required_document_total"/><field name="required_document_missing"/><field name="is_complete"/></list>
                            <form string="Expediente de crédito">
                                <header>
                                    <button name="action_mark_submitted" type="object" string="Enviar a revisión" class="btn-primary" invisible="state == 'submitted' or state == 'accepted'" groups="custom_web_credito_conedera.group_credit_administrator"/>
                                    <button name="action_mark_accepted" type="object" string="Aceptar documentación" class="btn-primary" invisible="state == 'accepted'" groups="custom_web_credito_conedera.group_credit_administrator"/>
                                    <button name="action_request_correction" type="object" string="Solicitar correcciones" invisible="state == 'correction'" groups="custom_web_credito_conedera.group_credit_administrator"/>
                                    <field name="state" widget="statusbar" statusbar_visible="pending,submitted,accepted,correction"/>
                                </header>
                                <sheet>
                                    <group><field name="applicant_type_id"/><field name="required_document_total"/><field name="required_document_uploaded"/><field name="required_document_missing"/><field name="is_complete"/><field name="review_notes"/></group>
                                    <field name="document_line_ids" context="{'default_document_id': id}">
                                        <list editable="bottom">
                                            <field name="requirement_id" domain="[('applicant_type_id', '=', parent.applicant_type_id)]"/>
                                            <field name="file" filename="filename"/>
                                            <field name="filename"/>
                                            <field name="uploaded_at" readonly="1"/>
                                        </list>
                                    </field>
                                </sheet>
                            </form>
                        </field>
                    </page>
                    <page string="Ubicación y croquis (cliente)" groups="custom_web_credito_conedera.group_credit_manager" class="o_credit_verification_page">
    <div class="alert alert-info mb-3" role="alert">Estos datos y el croquis los completa el cliente desde el portal. El personal de revisión solo puede consultarlos; el administrador conserva la edición completa.</div>
    <group string="Identificación del solicitante" col="2" class="o_credit_verification_section">
        <field name="identification" readonly="1"/>
        <field name="applicant_name" readonly="1"/>
    </group>

    <group string="Ubicación proporcionada por el cliente" col="2" class="o_credit_verification_section">
        <field name="verification_province" readonly="not credit_is_admin"/>
        <field name="verification_city" readonly="not credit_is_admin"/>
        <field name="verification_canton" readonly="not credit_is_admin"/>
        <field name="verification_parish" readonly="not credit_is_admin"/>
        <field name="verification_neighborhood" readonly="not credit_is_admin"/>
        <field name="verification_address" readonly="not credit_is_admin"/>
        <field name="verification_house_number" readonly="not credit_is_admin"/>
        <field name="verification_reference" readonly="not credit_is_admin"/>
        <field name="verification_city_canton_parish" readonly="1" invisible="not verification_city_canton_parish"/>
    </group>

    <group string="Croquis proporcionado por el cliente" col="2" class="o_credit_verification_section">
        <field name="verification_sketch" readonly="not credit_is_admin" filename="verification_sketch_filename" help="El croquis debe incluir dos calles principales"/>
        <field name="verification_sketch_filename" invisible="1"/>
    </group>

</page>
                    <page string="Verificación de ubicación (uso interno)" groups="custom_web_credito_conedera.group_credit_manager" class="o_credit_verification_page">
    <div class="alert alert-info mb-3" role="alert">
        La revisión del crédito y la verificación del negocio se realizan en paralelo.
        Para aprobar una solicitud se requiere: estado Verificado, inspección realizada,
        dirección encontrada, dirección registrada por el cliente y nombre del verificador.
    </div>

    <group string="Verificación del negocio (personal CONEDERA)" col="2" class="o_credit_verification_section">
        <field name="verification_zone"/>
        <field name="verification_local_state"/>
        <field name="interviewed_person"/>
        <field name="interviewed_relationship"/>
    </group>

    <group string="Resultados de la verificación (personal CONEDERA)" col="2" class="o_credit_verification_section">
        <field name="inspection_done"/>
        <field name="address_found"/>
        <field name="client_lives_there"/>
        <field name="sketch_needed"/>
    </group>

    <group string="Responsable y cierre de la verificación" col="2" class="o_credit_verification_section">
        <field name="verification_status"/>
        <field name="verifier_name"/>
        <field name="verifier_signature" filename="verifier_signature_filename"/>
        <field name="verifier_signature_filename" invisible="1"/>
        <field name="verification_completed_at" readonly="1"/>
    </group>
</page><page string="Historial de etapas"><field name="history_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="date" readonly="1"/><field name="stage_id" readonly="1"/><field name="user_id" readonly="1"/><field name="notes" readonly="1"/><field name="visible_to_portal" readonly="1"/></list></field></page>
                </notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_conedera_credit_applications" model="ir.actions.act_window"><field name="name">Solicitudes de crédito</field><field name="res_model">conedera.credit.application</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_conedera_credit_application_search"/><field name="context">{'search_default_group_stage': 1}</field></record>
    <menuitem id="menu_conedera_credit_root" name="Crédito CONEDERA" sequence="45" groups="custom_web_credito_conedera.group_credit_manager"/>
    <menuitem id="menu_conedera_credit_applications" name="Solicitudes" parent="menu_conedera_credit_root" action="action_conedera_credit_applications" sequence="10" groups="custom_web_credito_conedera.group_credit_manager"/>
    <menuitem id="menu_conedera_credit_stages" name="Etapas del flujo" parent="menu_conedera_credit_root" action="action_conedera_credit_stages" sequence="30" groups="custom_web_credito_conedera.group_credit_manager"/>
</odoo>