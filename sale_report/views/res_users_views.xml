<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="view_users_form_inherit_sales_report" model="ir.ui.view">
            <field name="name">res.users.form.sales.report</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook/page[@name='preferences']" position="after">
                    <page string="Empresas Dashboard">
                        <field name="empresa_rel_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="empresa_id"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
