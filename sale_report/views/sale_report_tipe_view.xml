<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sales_report_tipo_tree" model="ir.ui.view">
            <field name="name">sales.report.tipo.tree</field>
            <field name="model">sales.report.tipo</field>
            <field name="groups_id" eval="[(4, ref('group_sales_report_user')), (4, ref('group_sales_report_tipo_manager'))]"/>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_sales_report_tipo_form" model="ir.ui.view">
            <field name="name">sales.report.tipo.form</field>
            <field name="model">sales.report.tipo</field>
            <field name="groups_id" eval="[(4, ref('group_sales_report_tipo_manager'))]"/>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sales_report_tipo" model="ir.actions.act_window">
            <field name="name">Agregar Opciones</field>
            <field name="res_model">sales.report.tipo</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_sales_report_tipo"
            name="Agregar Opciones"
            parent="menu_kadoshcell_root"
            action="action_sales_report_tipo"
            groups="group_sales_report_tipo_manager"/>

    </data>
</odoo>
