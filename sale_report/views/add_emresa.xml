<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="view_sales_report_empresa_tree" model="ir.ui.view">
            <field name="name">sales.report.empresa.tree</field>
            <field name="model">sales.report.empresa</field>
            <field name="groups_id" eval="[(4, ref('group_sales_report_user')), (4, ref('group_sales_report_tipo_manager'))]"/>
            <field name="arch" type="xml">
                <list>
                    <field name="id_empresa"/>
                    <field name="name"/>
                    <field name="api_id"/> 
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_sales_report_empresa_form" model="ir.ui.view">
            <field name="name">sales.report.empresa.form</field>
            <field name="model">sales.report.empresa</field>
            <field name="groups_id" eval="[(4, ref('group_sales_report_tipo_manager'))]"/>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="id_empresa"/>
                            <field name="name"/>
                            <field name="api_id"/> 
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sales_report_empresa" model="ir.actions.act_window">
            <field name="name">Agregar Empresa</field>
            <field name="res_model">sales.report.empresa</field>
            <field name="view_mode">list,form</field>
            <field name="groups_id" eval="[(4, ref('group_sales_report_tipo_manager'))]"/>
        </record>

        <menuitem id="menu_sales_report_empresa"
            name="Agregar Empresa"
            parent="menu_kadoshcell_root"
            action="action_sales_report_empresa"
            groups="group_sales_report_tipo_manager"/>

    </data>

</odoo>
